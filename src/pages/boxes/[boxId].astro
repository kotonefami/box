---
import Layout from "../../layouts/Layout.astro";
import Banner from "../../components/Banner.astro";
import BoxForm from "../../components/BoxForm.astro";
import { boxExists, getBoxDisplayName } from "../../utils/box";
import DefaultDescription from "../../components/box/description/DefaultDescription.astro";

export const prerender = false;

const { boxId } = Astro.params;

if (!boxId || !boxExists(boxId)) {
    return Astro.rewrite("/404");
}

const boxName = getBoxDisplayName(boxId);
---

<Layout title={boxName}>
    <Banner />
    <BoxForm boxId={boxId} />
    {boxId === "default" ? <DefaultDescription /> : null}
</Layout>
