---
import BoxForm from "./BoxForm.astro";

interface Props {
    boxId: string;
    boxName: string;
}

const { boxId, boxName } = Astro.props;
---

<img src="/favicon.webp" width="400" height="400" alt={boxName} />
<h1>{boxName}</h1>
<BoxForm boxId={boxId} />
<slot />

<style is:inline>
    main img {
        display: block;
        width: 128px;
        height: 128px;
        border-radius: 1em;
        margin-inline: auto;
    }
</style>
